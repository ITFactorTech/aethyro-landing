{
  "name": "aethyro-landing",
  "compatibility_date": "2026-09-19",
  "assets": {
    // html_handling: "none" was tried to stop /pricing.html -> /pricing
    // redirects, but it also disables Wrangler's implicit directory-index
    // resolution: "/" and "/marketplace/" 404'd, only the literal
    // "/index.html" path worked. That's worse than the redirect it fixed,
    // so this stays on the default (auto-trailing-slash).
    "directory": "."
  }
}
